@PACKAGE_INIT@

# the installed lifetime checker (used by mlxf_check_lifetime below), resolved before any dependency is found: a
# nested package configuration of CMake 3.29 or older rewrites PACKAGE_PREFIX_DIR to its own prefix (mlx-c's here)
set(mlxf_LIFETIME_CHECKER "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/mlxf/check_consumer.py")

set(mlxf_Fortran_COMPILER_ID "@CMAKE_Fortran_COMPILER_ID@")
set(mlxf_Fortran_COMPILER_VERSION "@CMAKE_Fortran_COMPILER_VERSION@")
# the mlx-c release whose headers the archive's bind(c) layer was generated from: exactly that one is accepted
set(mlxf_MLXC_VERSION "@MLXC_VERSION@")
if(NOT CMAKE_Fortran_COMPILER_LOADED)
    set(mlxf_FOUND FALSE)
    set(mlxf_NOT_FOUND_MESSAGE "Enable the Fortran language before finding mlxf.")
    return()
endif()
if(NOT CMAKE_Fortran_COMPILER_ID STREQUAL mlxf_Fortran_COMPILER_ID OR
   NOT CMAKE_Fortran_COMPILER_VERSION STREQUAL mlxf_Fortran_COMPILER_VERSION)
    set(mlxf_FOUND FALSE)
    set(mlxf_NOT_FOUND_MESSAGE
        "mlxf Fortran compiler mismatch: installed modules require ${mlxf_Fortran_COMPILER_ID} ${mlxf_Fortran_COMPILER_VERSION}; consumer uses ${CMAKE_Fortran_COMPILER_ID} ${CMAKE_Fortran_COMPILER_VERSION}. Rebuild mlxf with the consumer's compiler.")
    return()
endif()

# mlx-c 0.8.0 uses MLX_C in its package-result helper; acknowledge that upstream name mismatch locally.
set(_mlxf_fphsa_defined FALSE)
if(DEFINED FPHSA_NAME_MISMATCHED)
    set(_mlxf_fphsa_defined TRUE)
    set(_mlxf_saved_fphsa "${FPHSA_NAME_MISMATCHED}")
endif()
set(FPHSA_NAME_MISMATCHED TRUE)
find_package(MLXC CONFIG QUIET)
if(_mlxf_fphsa_defined)
    set(FPHSA_NAME_MISMATCHED "${_mlxf_saved_fphsa}")
else()
    unset(FPHSA_NAME_MISMATCHED)
endif()
unset(_mlxf_saved_fphsa)
unset(_mlxf_fphsa_defined)
if(NOT MLXC_FOUND OR NOT TARGET mlxc)
    set(mlxf_FOUND FALSE)
    set(mlxf_NOT_FOUND_MESSAGE
        "mlxf needs shared mlx-c (built with @MLXC_VERSION@). Install the compatible MLX/mlx-c pair or set MLXC_ROOT to its prefix. ${MLXC_NOT_FOUND_MESSAGE}")
    return()
endif()
if(NOT MLXC_VERSION VERSION_EQUAL mlxf_MLXC_VERSION)
    set(mlxf_FOUND FALSE)
    set(mlxf_NOT_FOUND_MESSAGE
        "mlxf mlx-c mismatch: built with ${mlxf_MLXC_VERSION}; found ${MLXC_VERSION} at ${MLXC_DIR}. The installed interfaces were generated from mlx-c ${mlxf_MLXC_VERSION}'s headers: install that release (or set MLXC_ROOT to its prefix), or rebuild mlxf against the one found.")
    return()
endif()
get_target_property(_mlxf_mlxc_type mlxc TYPE)
if(NOT _mlxf_mlxc_type STREQUAL "SHARED_LIBRARY")
    set(mlxf_FOUND FALSE)
    set(mlxf_NOT_FOUND_MESSAGE "mlxf requires shared mlx-c; the discovered mlxc target is ${_mlxf_mlxc_type}.")
    return()
endif()
unset(_mlxf_mlxc_type)
if(@USE_OPENMP@)
    find_package(OpenMP QUIET COMPONENTS Fortran)
    if(NOT OpenMP_Fortran_FOUND)
        set(mlxf_FOUND FALSE)
        set(mlxf_NOT_FOUND_MESSAGE "mlxf was built with OpenMP. Use a GNU Fortran installation with libgomp (Homebrew gcc), or rebuild mlxf with USE_OPENMP=OFF.")
        return()
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/mlxfTargets.cmake")

# the lifetime checker (Python 3.7 or newer, standard library): `check_consumer.py --rules` lists what it reports
# and what it cannot see. mlxf_check_lifetime(<target>) runs it on the target's Fortran sources before the target
# is built, and a finding fails the build; without a Python 3.7 it warns and checks nothing. Its path is resolved
# above, before mlx-c's package is found (see there)
function(mlxf_check_lifetime target)
    find_package(Python3 3.7 QUIET COMPONENTS Interpreter)
    if(NOT Python3_Interpreter_FOUND)
        message(WARNING "mlxf_check_lifetime(${target}): no Python 3.7 or newer found; the lifetime check is skipped")
        return()
    endif()
    get_target_property(_mlxf_sources ${target} SOURCES)
    get_target_property(_mlxf_dir ${target} SOURCE_DIR)
    set(_mlxf_files "")
    foreach(_mlxf_source IN LISTS _mlxf_sources)
        if(_mlxf_source MATCHES "\\.[Ff](90|95|03|08)$")
            get_filename_component(_mlxf_path "${_mlxf_source}" ABSOLUTE BASE_DIR "${_mlxf_dir}")
            list(APPEND _mlxf_files "${_mlxf_path}")
        endif()
    endforeach()
    if(_mlxf_files)
        add_custom_target(${target}_mlxf_lifetime
            COMMAND Python3::Interpreter "${mlxf_LIFETIME_CHECKER}" ${_mlxf_files}
            COMMENT "mlxf lifetime check of ${target}" VERBATIM)
        add_dependencies(${target} ${target}_mlxf_lifetime)
    endif()
endfunction()
check_required_components(mlxf)
